<?xml version="1.0" encoding="utf-8"?>
<package version="2.1" id="{3c7d5a19-8e24-4b6f-a0d3-6f1b2e9c4a57}" target="Five">
  <metadata>
    <name>GTA VI-Inspired HUD - gameconfig + dlclist patch</name>
    <version><major>1</major><minor>3</minor><tag>PATCH</tag></version>
    <author><displayName>FBICat</displayName></author>
    <description><![CDATA[Edits mods\update\update.rpf. Install to the mods folder. Works for GTA V Legacy and Enhanced.

dlclist.xml     adds dlcpacks:/vihudfonts/ and dlcpacks:/vihudanims/ (the Lucia packs stay commented out for now)
gameconfig.xml  MetaDataStore 4000, ExprDictStore 400, TxdStore 150000, DwdStore 30000, MaxExtraPedModelInfos 600

1.3: raises MetaDataStore (3200 by default). It's the pool Lucia's ped files overflowed while the game was loading.
Lucia herself is coming in a later update, so her packs are installed but not registered yet.
Install it only once. If you installed an older version, restore update.rpf first so the packs aren't listed twice.]]></description>
  </metadata>
  <colors>
    <headerBackground useBlackTextColor="false">$FF2B1B3D</headerBackground>
    <iconBackground>$FFE06AA8</iconBackground>
  </colors>
  <content>
    <archive path="update\update.rpf" createIfNotExist="True" type="RPF7">
      <xml path="common\data\dlclist.xml">
        <add xpath="/SMandatoryPacksData/Paths" append="Last">
          <Item>dlcpacks:/vihudfonts/</Item>
          <Item>dlcpacks:/vihudanims/</Item>
        </add>
      </xml>
      <!-- Lucia (commented out until a later update):
      <xml path="common\data\dlclist.xml">
        <add xpath="/SMandatoryPacksData/Paths" append="Last">
          <Item>dlcpacks:/luciaped/</Item>
          <Item>dlcpacks:/luciaolf/</Item>
        </add>
      </xml>
      -->
      <xml path="common\data\gameconfig.xml">
        <replace xpath="/fwAllConfigs/ConfigArray/Item/Config/PoolSizes/Entries/Item[PoolName='MetaDataStore']/PoolSize">
          <PoolSize value="4000" />
        </replace>
        <replace xpath="/fwAllConfigs/ConfigArray/Item/Config/PoolSizes/Entries/Item[PoolName='ExprDictStore']/PoolSize">
          <PoolSize value="400" />
        </replace>
        <replace xpath="/fwAllConfigs/ConfigArray/Item/Config/PoolSizes/Entries/Item[PoolName='TxdStore']/PoolSize">
          <PoolSize value="150000" />
        </replace>
        <replace xpath="/fwAllConfigs/ConfigArray/Item/Config/PoolSizes/Entries/Item[PoolName='DwdStore']/PoolSize">
          <PoolSize value="30000" />
        </replace>
        <replace xpath="/fwAllConfigs/ConfigArray/Item/Config/ConfigModelInfo/MaxExtraPedModelInfos">
          <MaxExtraPedModelInfos value="600" />
        </replace>
      </xml>
    </archive>
  </content>
</package>
